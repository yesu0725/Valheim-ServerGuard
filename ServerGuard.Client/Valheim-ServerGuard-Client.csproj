<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Valheim-ServerGuard-Client</AssemblyName>
    <RootNamespace>ValheimServerGuardClient</RootNamespace>
    <Version>1.6.3</Version>
    <Description>Valheim ServerGuard Client - companion plugin that attests the client's mod list to a ServerGuard-protected server</Description>
    <Authors>yesu0725</Authors>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimManaged Condition="'$(VALHEIM_PATH)' != '' AND Exists('$(VALHEIM_PATH)\valheim_server_Data\Managed')">$(VALHEIM_PATH)\valheim_server_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND '$(VALHEIM_PATH)' != '' AND Exists('$(VALHEIM_PATH)\valheim_Data\Managed')">$(VALHEIM_PATH)\valheim_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\valheim_server_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\valheim_server_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed</ValheimManaged>

    <BepInExCore Condition="'$(VALHEIM_PATH)' != '' AND Exists('$(VALHEIM_PATH)\BepInEx\core')">$(VALHEIM_PATH)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\BepInEx\core')">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim\BepInEx\core')">C:\Program Files (x86)\Steam\steamapps\common\Valheim\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- Share the manifest DTO with the server project -->
    <Compile Include="..\Shared\Manifest.cs" Link="Shared\Manifest.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="12.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)\assembly_utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!--
    Post-build: copy the freshly-built client DLL into the Gale "HB Test" profile so
    the next Valheim launch picks it up automatically. Condition guards make it a
    silent no-op on machines without that folder - safe to commit.
    Override the destination with the SERVERGUARD_TEST_CLIENT_DIR env var if needed.

    Must be the TaegukGaming-Valheim_ServerGuard_Client mod subfolder, NEVER the
    BepInEx\plugins root: Gale installs the mod into that subfolder, BepInEx scans
    recursively, and a second copy at the root loads the plugin twice - the duplicate
    GUID then makes one instance fail.
  -->
  <Target Name="CopyToTestClient" AfterTargets="Build">
    <PropertyGroup>
      <_ServerGuardTestClientDir Condition="'$(SERVERGUARD_TEST_CLIENT_DIR)' != ''">$(SERVERGUARD_TEST_CLIENT_DIR)</_ServerGuardTestClientDir>
      <_ServerGuardTestClientDir Condition="'$(_ServerGuardTestClientDir)' == ''">C:\Users\yesu0725\AppData\Roaming\com.kesomannen.gale\valheim\profiles\HB Test\BepInEx\plugins\TaegukGaming-Valheim_ServerGuard_Client</_ServerGuardTestClientDir>
    </PropertyGroup>
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(_ServerGuardTestClientDir)"
      Condition="Exists('$(_ServerGuardTestClientDir)')"
      SkipUnchangedFiles="false" />
    <Message Importance="high" Text="[ServerGuard.Client] Client DLL copied to: $(_ServerGuardTestClientDir)" Condition="Exists('$(_ServerGuardTestClientDir)')" />
    <Message Importance="high" Text="[ServerGuard.Client] Skipped client-DLL copy (path missing): $(_ServerGuardTestClientDir)" Condition="!Exists('$(_ServerGuardTestClientDir)')" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Valheim-ServerGuard</AssemblyName>
    <RootNamespace>ValheimServerGuard</RootNamespace>
    <Version>1.5.0</Version>
    <Description>Valheim Server Guard - Anti-cheat and security mod for Valheim servers</Description>
    <Authors>yesu0725</Authors>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Set VALHEIM_PATH to the Valheim install root (client OR dedicated server). -->
    <!-- Defaults try common locations if VALHEIM_PATH is not set. -->
    <ValheimManaged Condition="'$(VALHEIM_PATH)' != '' AND Exists('$(VALHEIM_PATH)\valheim_server_Data\Managed')">$(VALHEIM_PATH)\valheim_server_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND '$(VALHEIM_PATH)' != '' AND Exists('$(VALHEIM_PATH)\valheim_Data\Managed')">$(VALHEIM_PATH)\valheim_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\valheim_server_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\valheim_server_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed</ValheimManaged>

    <BepInExCore Condition="'$(VALHEIM_PATH)' != '' AND Exists('$(VALHEIM_PATH)\BepInEx\core')">$(VALHEIM_PATH)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\BepInEx\core')">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim\BepInEx\core')">C:\Program Files (x86)\Steam\steamapps\common\Valheim\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- The client subproject has its own csproj; keep its sources out of the server build. -->
    <Compile Remove="ServerGuard.Client\**\*.cs" />
    <None Remove="ServerGuard.Client\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pulled from nuget.org -->
    <PackageReference Include="YamlDotNet" Version="12.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx + Harmony from a local BepInEx install -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Valheim engine assemblies -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)\assembly_utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>

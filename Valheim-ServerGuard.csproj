<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Valheim-ServerGuard</AssemblyName>
    <RootNamespace>ValheimServerGuard</RootNamespace>
    <Version>2.0.2</Version>
    <Description>Valheim ServerGuard - anti-cheat, mod allowlist and admin tools for Valheim. One DLL for both the dedicated server and the client.</Description>
    <Authors>yesu0725</Authors>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- tests/ is a separate project (Unity-free tests); keep its sources out of the plugin. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Set VALHEIM_PATH to the Valheim install root (client OR dedicated server). -->
    <!-- Defaults try common locations if VALHEIM_PATH is not set. -->
    <ValheimManaged Condition="'$(VALHEIM_PATH)' != '' AND Exists('$(VALHEIM_PATH)\valheim_server_Data\Managed')">$(VALHEIM_PATH)\valheim_server_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND '$(VALHEIM_PATH)' != '' AND Exists('$(VALHEIM_PATH)\valheim_Data\Managed')">$(VALHEIM_PATH)\valheim_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\valheim_server_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\valheim_server_Data\Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed</ValheimManaged>

    <!-- BEPINEX_CORE overrides the BepInEx core folder independently of VALHEIM_PATH
         (useful when the game install has no BepInEx and a mod-manager profile does). -->
    <BepInExCore Condition="'$(BEPINEX_CORE)' != '' AND Exists('$(BEPINEX_CORE)')">$(BEPINEX_CORE)</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND '$(VALHEIM_PATH)' != '' AND Exists('$(VALHEIM_PATH)\BepInEx\core')">$(VALHEIM_PATH)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\BepInEx\core')">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim\BepInEx\core')">C:\Program Files (x86)\Steam\steamapps\common\Valheim\BepInEx\core</BepInExCore>
    <!-- Last resort on the dev machine: the Gale test profile ships its own BepInEx core. -->
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(APPDATA)\com.kesomannen.gale\valheim\profiles\HB Test\BepInEx\core')">$(APPDATA)\com.kesomannen.gale\valheim\profiles\HB Test\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulled from nuget.org -->
    <PackageReference Include="YamlDotNet" Version="12.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx + Harmony from a local BepInEx install -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Valheim engine assemblies -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)\assembly_utils.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- UI assemblies: only the client half (Quick Login panel) touches these, but the
         merged DLL is compiled once so they are referenced unconditionally. They ship
         in both the client and the dedicated-server Managed folders. -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!--
    Post-build: copy the freshly-built DLL into the local test installs for fast
    iteration. ONE DLL now serves both sides, so it goes to both the dedicated server
    and the Gale "HB Test" client profile. The Condition guards make each copy a
    silent no-op on any machine that doesn't have that exact path - safe to commit.
    Override the destinations with SERVERGUARD_TEST_SERVER_DIR / SERVERGUARD_TEST_CLIENT_DIR.

    Destinations are the Thunderstore-style mod folder (TaegukGaming-Valheim_ServerGuard),
    NOT the plugins root. BepInEx scans plugins/ recursively, so a copy in both places is
    loaded twice and the duplicate GUID makes one of them fail.
  -->
  <Target Name="CopyToTestInstalls" AfterTargets="Build">
    <PropertyGroup>
      <_ServerGuardTestServerDir Condition="'$(SERVERGUARD_TEST_SERVER_DIR)' != ''">$(SERVERGUARD_TEST_SERVER_DIR)</_ServerGuardTestServerDir>
      <_ServerGuardTestServerDir Condition="'$(_ServerGuardTestServerDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server\BepInEx\plugins\TaegukGaming-Valheim_ServerGuard</_ServerGuardTestServerDir>
      <_ServerGuardTestClientDir Condition="'$(SERVERGUARD_TEST_CLIENT_DIR)' != ''">$(SERVERGUARD_TEST_CLIENT_DIR)</_ServerGuardTestClientDir>
      <_ServerGuardTestClientDir Condition="'$(_ServerGuardTestClientDir)' == ''">C:\Users\yesu0725\AppData\Roaming\com.kesomannen.gale\valheim\profiles\HB Test\BepInEx\plugins\TaegukGaming-Valheim_ServerGuard</_ServerGuardTestClientDir>
      <!-- Pre-2.0 client package folder in the same profile. If it still exists it holds
           the old standalone companion DLL, which would run alongside the merged one. -->
      <_ServerGuardLegacyClientDir>$(_ServerGuardTestClientDir)\..\TaegukGaming-Valheim_ServerGuard_Client</_ServerGuardLegacyClientDir>
    </PropertyGroup>

    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(_ServerGuardTestServerDir)"
      Condition="Exists('$(_ServerGuardTestServerDir)')"
      SkipUnchangedFiles="false" />
    <Message Importance="high" Text="[ServerGuard] DLL copied to test server: $(_ServerGuardTestServerDir)" Condition="Exists('$(_ServerGuardTestServerDir)')" />
    <Message Importance="high" Text="[ServerGuard] Skipped test-server copy (path missing): $(_ServerGuardTestServerDir)" Condition="!Exists('$(_ServerGuardTestServerDir)')" />

    <!-- The Gale "HB Test" profile is THE client test target: every build goes there and
         nowhere else (no other Gale profile). Create the mod folder if the profile exists
         but the folder doesn't, so a fresh profile still receives the DLL. -->
    <MakeDir Directories="$(_ServerGuardTestClientDir)" Condition="Exists('$(_ServerGuardTestClientDir)\..')" />
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(_ServerGuardTestClientDir)"
      Condition="Exists('$(_ServerGuardTestClientDir)')"
      SkipUnchangedFiles="false" />
    <Message Importance="high" Text="[ServerGuard] DLL copied to test client: $(_ServerGuardTestClientDir)" Condition="Exists('$(_ServerGuardTestClientDir)')" />
    <Message Importance="high" Text="[ServerGuard] Skipped test-client copy (path missing): $(_ServerGuardTestClientDir)" Condition="!Exists('$(_ServerGuardTestClientDir)')" />

    <!-- Guard against duplicate loads: a stray loose DLL at the plugins root, or the
         pre-2.0 companion package still installed next to the merged mod. -->
    <Warning
      Text="[ServerGuard] Stray copy found at the client plugins root ($(_ServerGuardTestClientDir)\..\Valheim-ServerGuard.dll). BepInEx scans recursively, so it loads twice and one instance fails on the duplicate GUID. Delete the loose file."
      Condition="Exists('$(_ServerGuardTestClientDir)\..\Valheim-ServerGuard.dll')" />
    <Warning
      Text="[ServerGuard] Pre-2.0 client companion still installed at $(_ServerGuardLegacyClientDir). Uninstall Valheim_ServerGuard_Client from the profile - the merged mod replaces it."
      Condition="Exists('$(_ServerGuardLegacyClientDir)\Valheim-ServerGuard-Client.dll')" />
  </Target>

</Project>
